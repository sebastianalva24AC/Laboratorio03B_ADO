<Window x:Class="Laboratorio03B_ADO.Views.StudentsDataReaderView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estudiantes - DataReader" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="txtSearchName" Width="200" Margin="0,0,10,0"/>
            <Button Content="Buscar" Click="btnSearch_Click"/>
        </StackPanel>
        <DataGrid x:Name="dgStudents" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>